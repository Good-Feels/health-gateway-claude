{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "health-gateway",
  "displayName": "A Good Sign",
  "version": "1.1.4",
  "description": "Compare your Apple Health and Apple Watch data in Claude: sleep stages, workouts, steps, resting heart rate, and heart rate variability (HRV). See your estimated Sleep Score and personal bests in the A Good Sign iPhone app.",
  "author": {
    "name": "Good Feels, Inc.",
    "email": "hello@getgoodfeels.com",
    "url": "https://agoodsign.app/"
  },
  "homepage": "https://agoodsign.app/",
  "documentationUrl": "https://agoodsign.app/setup",
  "supportUrl": "https://agoodsign.app/support",
  "privacyPolicyUrl": "https://agoodsign.app/privacy",
  "termsOfServiceUrl": "https://agoodsign.app/terms",
  "icon": "./assets/app-icon.png",
  "repository": "https://github.com/Good-Feels/health-gateway-claude",
  "license": "Apache-2.0",
  "keywords": [
    "apple-health",
    "healthkit",
    "apple-watch",
    "fitness",
    "workouts",
    "sleep-tracking",
    "sleep-stages",
    "sleep-score",
    "heart-rate",
    "resting-heart-rate",
    "heart-rate-variability",
    "hrv",
    "steps",
    "wellness",
    "mcp"
  ],
  "defaultEnabled": false
}
